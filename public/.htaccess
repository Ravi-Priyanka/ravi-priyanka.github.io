# Hostinger / Apache settings for the static wedding site
ErrorDocument 404 /404.html
DirectoryIndex index.html

<IfModule mod_headers.c>
  # Next.js names these files with content hashes, so they can be cached for a year
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Artwork can change, so cache it for a week
  <FilesMatch "\.(webp|jpg|png|svg|mp3)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  # Always fetch the latest page
  <FilesMatch "\.(html|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
